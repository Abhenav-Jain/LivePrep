# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# LivePrep authentication token (required for WebSocket connections)
LIVEPREP_TOKEN=change_this_to_a_strong_random_token

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000

# Development mode (enables uvicorn reload)
DEV=0

# Max concurrent WebSocket sessions
MAX_CONCURRENT_SESSIONS=5

# Live API Model
# Options: gemini-3.8-live, gemini-3.8-live-extended-thinking
GEMINI_LIVE_MODEL=gemini-3.8-live

# Safe Workspace root for file operations (isolated workspace/, NOT repo root)
PROJECT_WORKSPACE_ROOT=./workspace
