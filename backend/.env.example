# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed Origins for CORS and WebSocket (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000

# Development mode (enables uvicorn reload)
DEV=0

# Max concurrent WebSocket sessions (default 3)
MAX_CONCURRENT_SESSIONS=3

# Practice minutes allowed per user per UTC day (default 30, 0 disables the limit).
# Each live minute costs money; this stops one account draining the Gemini quota.
DAILY_MINUTES_LIMIT=30

# Live API Model
# Options: gemini-3.8-live, gemini-3.8-live-extended-thinking
GEMINI_LIVE_MODEL=gemini-3.8-live

# PostgreSQL Database (Supabase)
# Use the SESSION pooler string (port 5432) from Supabase > Connect > Session pooler.
# Username looks like postgres.<project-ref>. Replace [YOUR-PASSWORD] and remove the brackets.
# Do not use the Transaction pooler (port 6543) unless you know the prepared-statement caveats.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800

# Session duration limits & idle timeout
MAX_SESSION_MINUTES=20
IDLE_TIMEOUT_SECONDS=120

# Authentication timeout for the first WebSocket message, the one-time login ticket (seconds)
AUTH_TIMEOUT_SECONDS=10

# Lifetime of a one-time WebSocket login ticket (seconds)
WS_TICKET_TTL_SECONDS=60

# Idle handling: warn the user this many seconds before an idle timeout ends the call, and
# treat audio below this loudness (RMS) as silence. Lower it if quiet speakers get cut off.
IDLE_WARNING_SECONDS=30
AUDIO_SILENCE_RMS_THRESHOLD=100

# Supabase Auth (JWT verification). Project URL: no trailing slash.
# The backend verifies user tokens with the public keys at <SUPABASE_URL>/auth/v1/.well-known/jwks.json
# (open that URL in a browser: it must list at least one ES256/RS256 key).
SUPABASE_URL=https://your-project-ref.supabase.co
# Optional, default is "authenticated"
SUPABASE_JWT_AUDIENCE=authenticated

# Post-session reports (Step 6)
# Text model used to analyse the transcript. Required for reports; without it every
# report is stored with status=failed (the transcript and objective metrics are kept).
# Example: gemini-2.5-flash (check Google AI Studio for the current text models).
# Use a lite model (gemini-2.5-flash-lite) to save quota: reports still parse, but the
# written feedback is blunter. Give that model a valid key with report quota left.
REPORT_MODEL=gemini-2.5-flash
# Generate a report automatically when a call ends (0 disables it; used by the tests).
REPORT_AUTO_GENERATE=1
# Timeout for one report model call, in seconds (one retry follows a timeout).
REPORT_LLM_TIMEOUT_SECONDS=45
# Report jobs that may run at once (several calls can end together).
MAX_CONCURRENT_REPORT_JOBS=2
# Rebuilding a report costs up to two model calls, so it is rate limited per user.
# REPORT_RETRY_LIMIT attempts per REPORT_RETRY_WINDOW_SECONDS (0 disables the limit).
REPORT_RETRY_LIMIT=10
REPORT_RETRY_WINDOW_SECONDS=3600
# Reports a restart may rebuild on startup (left pending by the previous process).
REPORT_RECOVERY_LIMIT=20
