# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# LivePrep authentication token (required for WebSocket connections, min 32 chars)
LIVEPREP_TOKEN=change_this_to_a_strong_random_token_min_32_chars_long

# Allowed Origins for CORS and WebSocket (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000

# Development mode (enables uvicorn reload)
DEV=0

# Max concurrent WebSocket sessions (default 3)
MAX_CONCURRENT_SESSIONS=3

# Live API Model
# Options: gemini-3.8-live, gemini-3.8-live-extended-thinking
GEMINI_LIVE_MODEL=gemini-3.8-live

# Directory for SQLite database and persistent data
DATA_DIR=./data

# PostgreSQL Database (Supabase)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres (Transaction pooler)
# Or direct: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800

# Session duration limits & idle timeout
MAX_SESSION_MINUTES=20
IDLE_TIMEOUT_SECONDS=120

# Authentication timeout for WebSocket initial auth message (seconds)
AUTH_TIMEOUT_SECONDS=10
