# Public Supabase settings for login. They are baked into the browser bundle at build time,
# so restart `npm run dev` after changing them.
#
# VITE_SUPABASE_URL: Supabase project URL, e.g. https://abcdefghijklmnop.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY: the PUBLISHABLE key (sb_publishable_...) from
#   Project Settings > API Keys. It is meant to be public.
#   NEVER put the secret key or the service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
